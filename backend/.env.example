DATABASE_URL=sqlite:///./signal_clone.db
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated list of frontend origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3000
# Optional: regex for extra origins, e.g. Vercel preview deployments.
# ALLOWED_ORIGIN_REGEX=https://signal-clone-.*\.vercel\.app

# Where uploaded attachments are stored, and the per-file size limit in MB.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# Set to true to create the demo users/conversations on startup (no-op if data exists).
SEED_ON_START=false
